    "content": "use internship_prep;\ncreate TABLE insurance_claims(\npatient_id int primary key,\nage int,\nclaim_amount INT);\ninsert into insurance_claims (patient_id,age,claim_amount)\nvalues\n(701,25,1500),\n(702,45,45000),\n(703,35,12000),\n(704,60,150000),\n(705,22,800);\nSELECT * FROM insurance_claims;\n# min max\nSELECT patient_id,claim_amount,\n(claim_amount-min(claim_amount) over ())*1.0 /\n(max(claim_amount) over() - min(claim_amount) over ()) as minmax_scaled_\nfrom insurance_claims;\n# standard division\n\nselect patient_id,claim_amount,\n(claim_amount - avg(claim_amount) over()) / STDDEV(claim_amount) over() as standard_scaled\nfrom insurance_claims;\nselect patient_id,age,\n(age-avg(age) over()) / STDDEV(age) over() as scaled_age\nfrom insurance_claims;\n",
