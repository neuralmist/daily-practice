    "content": "\\about\nshow DATABASES;\nuse internship_prep;\nshow tables;\nDROP table daily_fever_cases;\nCREATE TABLE daily_fever_cases(\nrecord_date DATE PRIMARY KEY,\nnew_cases INT\n);\nINSERT into daily_fever_cases(record_date,new_cases) VALUES\n('2026-10-01',45),\n('2026-10-02',52),\n('2026-10-03',48),\n('2026-10-04',60),\n('2026-10-05',55);\ndesc daily_fever_cases;\nSELECT * FROM daily_fever_cases;\nSELECT record_date,\nnew_cases,\nrank() over (order by new_cases desc) as severity_rank\nfrom daily_fever_cases;\n#lag\n\nselect record_date,\nnew_cases,\nLAG(new_cases,1) over (order by record_date) as yesterday_cases,\n(new_cases-LAG(new_cases,1) over (order by record_date)) as daily_change\nfrom daily_fever_cases;\nselect sum(new_cases) from daily_fever_cases where record_date BETWEEN '2026-10-02' and '2026-10-04';\nselect AVG(new_cases) from daily_fever_cases where record_date in (\"2026-10-04\",\"2026-10-01\") ;\n",
