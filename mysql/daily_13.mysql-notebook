    "content": "use internship_prep;\ncreate table ehr_notes(\npatient_id int primary key,\ndoctors_note text);\nINSERT into ehr_notes(patient_id,doctors_note) VALUES\n(801,\"Pt admitted for migraine. BP: 140/90.Prescribed meds.\"),\n(802,\"Routine checkup.BP is 110/70 today.No complaints.\"),\n(803,\"Patient has a history of severe asthma.bp 135/85.\"),\n(804,\"Follow-up visit.Vitals normal.\");\nSELECT*from ehr_notes;\n# filter patient who have \"asthma\" anywhere  in their notes\nSELECT*\nFROM ehr_notes\nWHERE doctors_note LIKE \"%asthm%\";\n# select pattern of bp\n\nselect patient_id,\nREGEXP_SUBSTR(doctors_note,'[0-9]{2,3}/[0-9]{2,3}') as extracted_bp\nFROM ehr_notes;\nSELECT* from ehr_notes\nwhere doctors_note like \"%routine%\";\n",
