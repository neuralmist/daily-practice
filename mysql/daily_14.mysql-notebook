    "content": "use internship_prep;\ncreate table patient_demographics(\npatient_id int primary key,\npatient_name VARCHAR(50));\ninsert into patient_demographics(patient_id,patient_name) VALUES\n(902,\"Annie\"),\n(903,\"Justin\"),\n(904,\"Chase\"),\n(905,\"Rose\");\nselect * from patient_demographics;\ncreate table lab_results(\npatient_id int,\ncholesterol int);\ninsert into lab_results(patient_id,cholesterol) values \n(901,180),(902,220),(903,195),(905,240);\nselect * from lab_results;\n# inner join \nselect d.patient_id,d.patient_name,l.cholesterol\nfrom patient_demographics d \ninner join lab_results l  \non d.patient_id = l.patient_id\n#left join\nselect d.patient_id,d.patient_name,l.cholesterol\nfrom patient_demographics d \nleft join lab_results l  \non d.patient_id = l.patient_id;\n# replacing null value  \nselect d.patient_id,d.patient_name,\nIFNULL(l.cholesterol,\"yet to be entered..\") \nfrom patient_demographics d \nleft join lab_results l \non d.patient_id = l.patient_id\n# right join\n\nselect d.patient_id,d.patient_name,l.cholesterol\nfrom patient_demographics d \nright join lab_results l on d.patient_id=l.patient_id;\n# full join\n#select d.patient_id,d.patient_name,l.cholesterol\n#from patient_demographics d \n#full join lab_results l on d.patient_id=l.patient_id;\n\n# cross join  # not always recommeneded, 4x4\nSELECT d.patient_id,d.patient_name,l.cholesterol\nfrom patient_demographics d \ncross join lab_results l;\n",
