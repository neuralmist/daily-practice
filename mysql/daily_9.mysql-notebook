    "content": "show DATABASES;\nuse internship_prep;\nshow tables;\ndrop table patient_biometrics\ncreate TABLE patient_biometrics(\npatient_id int primary key,\nage int,\nbmi decimal(4,1),\ndiabetes_status INT);\ninsert into patient_biometrics (patient_id,age,bmi,diabetes_status) VALUES\n(1,25,22.5,0),\n(2,42,27.8,1),\n(3,37,24.1,0),\n(4,55,31.2,1),\n(5,61,29.5,1),\n(6,29,23.0,0),\n(7,48,26.5,0),\n(8,52,30.1,1);\nselect * from patient_biometrics;\n#EDA\n#youngest , oldest age & avg bmi\n\nselect MIN(age) as youngest_age,\nmax(age) as \"oldest(age)\",\nround(avg(bmi)) as average_bmi\nfrom patient_biometrics;\n#count groups\n\nselect CASE\nwhen age between 20 and 30 then \"20-30 years\"\nwhen age between 31 and 40 then \"31-40 years\"\nwhen age between 41 and 50 then \"41-50 years\"\nwhen age >= 51 then \"51+ year\"\nEND AS age_bucket,\ncount(patient_id) as patient_count\nfrom patient_biometrics\ngroup by age_bucket\nORDER BY age_bucket\n#group by diabetes_status\n#calculateavg bmi\n#count patient_status\n\nSELECT diabetes_status,\navg(bmi) as average_bmi,\ncount(patient_id) as patient_count\nfrom patient_biometrics\ngroup by diabetes_status\n",
