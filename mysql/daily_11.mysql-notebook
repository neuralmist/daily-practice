    "content": "\\about\nuse internship_prep;\nCREATE TABLE patient_lifestyle (\npatient_id int primary key,\ncity varchar(45),\nsmoker varchar(5));\ninsert into patient_lifestyle(patient_id,city,smoker) VALUES\n(601,\"udupi\",\"yes\"),\n(602,\"manipal\",\"no\"),\n(603,\"udupi\",\"no\"),\n(604,\"mangalore\",\"yes\");\n\nselect*from patient_lifestyle;\nDESCRIBE patient_lifestyle;\nSELECT \npatient_id,\ncase when smoker=\"yes\" then 1 else 0 end as smoker_yes,\ncase when smoker=\"no\" then 1 else 0 end as smoker_no\nfrom patient_lifestyle;\n# skipping city mangalore\n\nselect patient_id ,\ncase when city=\"manipal\" then 1 else 0 end as city_manipal,\ncase when city=\"udupi\" then 1 else 0 end as city_udupi\nfrom patient_lifestyle;\n#combining both ,\n# similar to get dummies in py\nselect patient_id, \ncase when smoker=\"yes\" then 1 else 0 end as smoker_yes,\ncase when city=\"udupi\" then 1 else 0 end as city_udupi,\ncase when city=\"manipal\" then 1 else 0 end as city_manipal\nfrom patient_lifestyle\n",
