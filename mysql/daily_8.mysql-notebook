    "content": "\\about\nshow DATABASES;\nuse internship_prep;\ncreate table clinical_trail_wide(\npatient_id int,\ntreatment varchar(20),\nweek_1_bp INT,\nweek_2_bp INT,\nweek_3_bp INT\n);\nINSERT into clinical_trail_wide(patient_id,treatment,week_1_bp,week_2_bp,week_3_bp) VALUES\n(501,'Drug_1',140,135,120),\n(502,'Placebo',150,148,145),\n(503,\"Drug_A\",135,130,128);\nSELECT*from clinical_trail_wide;\nDESCRIBE clinical_trail_wide;\nSELECT patient_id,treatment,\"week_1\" as measurement_week,week_1_bp as  blood_pressure\nFROM clinical_trail_wide\nUNION ALL\nSELECT patient_id,treatment,\"week_2\" as measurement_week,week_2_bp as blood_pressure \nfrom clinical_trail_wide\nUNION ALL\nSELECT patient_id,treatment,\"week_3\" as measurement_week,week_3_bp as blood_pressure\nFROM clinical_trail_wide\n;\n#order by\n\nSELECT patient_id,treatment,\"week_1\" as measurement_week,week_1_bp as  blood_pressure\nFROM clinical_trail_wide\nUNION ALL\nSELECT patient_id,treatment,\"week_2\" as measurement_week,week_2_bp as blood_pressure \nfrom clinical_trail_wide\nUNION ALL\nSELECT patient_id,treatment,\"week_3\" as measurement_week,week_3_bp as blood_pressure\nFROM clinical_trail_wide\nORDER BY patient_id,measurement_week;\n\n",
